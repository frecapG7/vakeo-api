# Pinned to a Node2Shell-patched release (CVE-2026-111497, fixed in 24.22.1+) — never use a floating tag here
FROM node:24.22.2-alpine3.24
WORKDIR /app
ENV NODE_ENV=production

# Dependencies layer — cached unless package*.json changes.
# npm ci installs exactly the lockfile; --omit=dev keeps the image lean.
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

# Application code
COPY . .

# Rebuild native modules against this stage if any dependency needs it (no-op otherwise)
RUN npm rebuild

# Never run as root — node:24-alpine ships an unprivileged `node` user
USER node

EXPOSE 3000
CMD ["node", "index.mjs"]
