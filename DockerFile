FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production

# Dependencies layer — cached unless package*.json changes.
# npm ci installs exactly the lockfile; --omit=dev keeps the image lean.
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Application code
COPY . .

# Rebuild native modules against this stage if any dependency needs it (no-op otherwise)
RUN npm rebuild

# Never run as root — node:22-alpine ships an unprivileged `node` user
USER node

EXPOSE 3000
CMD ["node", "index.mjs"]
